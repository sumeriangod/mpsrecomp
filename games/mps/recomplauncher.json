{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Mario Party Superstars",
  "repo": "sumeriangod/mpsrecomp",
  "inputs": [
    {
      "id": "game",
      "label": "Mario Party Superstars 1.0.0 (no update): a folder with its extracted ExeFS and RomFS",
      "formats": [{ "type": "folder" }],
      "check": { "nup_build_id": "0413a570bf2b3aa7741c20559ff7b8fa314adbf9" }
    }
  ],
  "prepare": {
    "label": "Recompile the game code",
    "program": ["mpsrecomp.exe", "mpsrecomp"],
    "args": ["--prepare", "{input:game}"],
    "env": { "LARECOMP_DATA_ROOT": "{data}" },
    "done": ["{data}/extracted/exefs/main", "{data}/extracted/mpsgame.dll"]
  },
  "start": {
    "program": ["mpsrecomp.exe", "mpsrecomp"],
    "args": ["--play"],
    "env": { "LARECOMP_DATA_ROOT": "{data}" }
  },
  "saves": ["{data}/save", "{data}/sysdata", "{data}/mps.ini"]
}
