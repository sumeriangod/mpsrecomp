# Everything derived from the player's dump stays local (scripts/check_no_proprietary.py blocks it too):
# extracted exefs/romfs, recompiled C, translated shaders, build products.
# (No trailing slash: these may be symlinks to another disk, which a "dir/" pattern would not match.)
/private
/generated
/build
/dist
*.spv
# Game containers, executables and keys never belong here
*.xci
*.nsp
*.nsz
*.xcz
*.nca
*.nso
*.nro
*keys*.txt
*.keys
prod.keys
title.keys
# Python environment for the recompiler (machine-specific)
/tools/venv
__pycache__/
*.pyc
.DS_Store
/.claude/worktrees/
